# Copy this file to .env and fill in your own values. Never commit .env.

# Required: create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Required: any OpenRouter model id
LLM_MODEL=google/gemma-4-31b-it:free

# Required: PostgreSQL database for preferences (local example credentials)
DATABASE_URL=postgresql://shopping:shopping@localhost:5432/shopping

# Used by database tests: keep separate from the application database
TEST_DATABASE_URL=postgresql://shopping:shopping@localhost:5432/shopping_test
